# Recommended (Vercel + Railway): browser calls this Next host `/api`.
# next.config rewrites proxy to Nest; session cookies are first-party (SameSite=Lax).
NEXT_PUBLIC_API_URL=same-origin
BACKEND_URL=https://capex-backend-production.up.railway.app

# Local same-origin (Next :3000 → Nest :3001):
# BACKEND_URL=http://localhost:3001

# Legacy cross-origin (not recommended): absolute Nest URL + COOKIE_SAMESITE=none on Railway.
# NEXT_PUBLIC_API_URL=https://capex-backend-production.up.railway.app

# Optional: Sentry DSN (omit to disable)
# NEXT_PUBLIC_SENTRY_DSN=
